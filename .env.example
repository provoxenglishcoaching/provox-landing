RESEND_API_KEY=your_resend_api_key_here

# ProVox Student Portal (/portal)
# Postgres connection string from Vercel Storage -> Postgres (Neon-backed)
DATABASE_URL=your_neon_postgres_connection_string
# Vercel Storage -> Blob
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token
# Random string, 32+ chars, used to encrypt portal session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string
# Used ONCE to bootstrap the coach master password into the database on first login.
# After that first successful bootstrap this value is never read again -- change the
# password through the coach settings panel instead.
MASTER_PASSWORD=set_your_initial_master_password
